{
  "expo": {
    "name": "Haazir",
    "slug": "haazir",
    "scheme": "haazir",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.haazir.mobile"
    },
    "android": {
      "package": "app.haazir.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#C42A40",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Haazir uses your location as the starting point for the hospital search."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#C42A40",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D42E45"
        }
      ]
    ],
    "backgroundColor": "#FFFFFF"
  }
}
