# Haazir — environment variables. Copy to .env.local and fill in. Never commit real values.

# ---------- App ----------
APP_BASE_URL=https://your-app.vercel.app   # public URL Bolna calls back (your ngrok/cloudflared URL in local dev)
DEMO_PASSCODE=change-me                    # simple console gate for the MVP
SIMULATION_MODE=false                      # true = no real calls; replays scenarios/demo-krait-bite.json

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=             # browser Realtime only; without it the board refreshes on each tick
SUPABASE_SERVICE_ROLE_KEY=                 # server only; not used by the app today (server writes go through DATABASE_URL)

# ---------- Bolna ----------
BOLNA_API_KEY=                             # server only
BOLNA_FROM_NUMBER=                         # optional E.164 caller ID; empty = account default (use an Indian number)
BOLNA_AGENT_ID_AVAILABILITY=
BOLNA_AGENT_ID_HOLD_CONFIRM=
BOLNA_AGENT_ID_RELEASE=
BOLNA_AGENT_ID_FAMILY=                     # stretch goal
BOLNA_WEBHOOK_SECRET=                      # appended as ?token=... to the webhook URL in every agent
BOLNA_FUNCTION_SECRET=                     # tools send "Authorization: Bearer <this>" via their api_token field

# ---------- WhatsApp ----------
WHATSAPP_PROVIDER=none                     # none | meta | twilio  (none = stored as simulated and shown in the UI)
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_GRAPH_VERSION=                        # current Graph API version from Meta's WhatsApp Cloud API docs
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=                      # whatsapp:+<sandbox or sender number from your Twilio console>

# ---------- Server database ----------
# Server routes talk to Postgres directly (raw SQL for matching and atomic wave claims).
# Supabase: Project Settings → Database → Connection pooling → transaction mode URI (port 6543).
# Local Postgres: postgres://user:pass@localhost:5432/haazir
# Zero-setup local/simulation: pglite:./.data/pglite (embedded Postgres; schema + seed applied on first run)
DATABASE_URL=pglite:./.data/pglite

# ---------- Console sign-in ----------
AUTH_MODE=passcode                         # passcode (one shared DEMO_PASSCODE) | users (email + password per user, per organisation)
SESSION_SECRET=                            # AUTH_MODE=users: 32+ random characters, e.g. `openssl rand -base64 48`
SUPABASE_JWT_SECRET=                       # Supabase → Project settings → API → JWT secret (legacy HS256). Lets Realtime use org-scoped RLS

# ---------- Background work ----------
CRON_SECRET=                               # protects /api/cron/tick; schedule it every minute (supabase/cron.sql)
RETENTION_DAYS=30                          # delete patient details and message bodies this many days after a referral ends
BOLNA_IP_ALLOWLIST=off                     # on = Bolna routes also require Bolna's documented source IPs
BOLNA_EXTRA_IPS=                           # comma-separated, if Bolna adds addresses

# ---------- WhatsApp (Meta) templates and inbound ----------
META_WA_TEMPLATE_PREARRIVAL=               # approved template names; empty = plain text (24-hour window only). See docs/whatsapp-templates.md
META_WA_TEMPLATE_DOCTOR=
META_WA_TEMPLATE_FAMILY=
META_WA_TEMPLATE_BED_REQUEST=
META_WA_VERIFY_TOKEN=                      # Meta webhook verification for /api/whatsapp/inbound
META_APP_SECRET=                           # checks X-Hub-Signature-256 on inbound messages

# ---------- Stretch features ----------
BOLNA_AGENT_ID_INBOUND=                    # inbound callback agent (attach it to your caller-ID number)
FAMILY_CALLS=on                            # C1: voice update to the family after the bed is confirmed (needs BOLNA_AGENT_ID_FAMILY for live calls)
MISSED_CALL_SECRET=                        # C3: /api/triggers/missed-call?token=… calls the family back
GOOGLE_PLACES_API_KEY=                     # optional: star ratings on the Hospitals page (Places API (New))
SARVAM_API_KEY=                            # C2: transcribes WhatsApp voice notes from doctors
SARVAM_STT_MODEL=saarika:v2.5
WHATSAPP_AVAILABILITY_PING=off             # C6: also send each bed request on WhatsApp; desks reply "YES R-4821"
AAPAT_SETU_URL=                            # C7: link added to the pre-arrival note, {code} is replaced, e.g. https://…/referral/{code}
MAX_ETA_CRITICAL_MIN=0                     # C8: skip hospitals further than this for critical patients unless none are nearer (0 = off)
MAX_ETA_SERIOUS_MIN=0
MAX_ACTIVE_LIVE_REFERRALS=10               # per organisation: live referrals calling hospitals at once (simulations don't count)
